<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Dudi_Project" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_neon_orange</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/primary_neon_glow</item>
        
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary_steel</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Status bar and Navigation bar -->
        <item name="android:statusBarColor">@color/bg_deep_dark</item>
        <item name="android:navigationBarColor">@color/bg_deep_dark</item>

        <!-- Background colors -->
        <item name="android:windowBackground">@color/bg_deep_dark</item>
        
        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/text_medium_emphasis</item>
        <item name="android:editTextColor">@color/white</item>

        <!-- Custom button style -->
        <item name="materialButtonStyle">@style/Widget.App.Button.Pill</item>
    </style>

    <!-- Unified Picker Theme -->
    <style name="Theme.App.Picker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/text_medium_emphasis</item>
        <item name="android:textColorPrimaryInverse">@color/black</item>
        <item name="android:colorControlNormal">@color/primary_neon_orange</item>
        <item name="android:colorControlActivated">@color/primary_neon_orange</item>
        <item name="android:headerBackground">@color/bg_card</item>
    </style>

    <style name="Widget.App.Button.Pill" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearance.App.Pill" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
</resources>