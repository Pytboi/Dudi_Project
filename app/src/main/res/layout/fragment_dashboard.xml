<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep_dark"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Header with Profile -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_small_profile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@color/bg_card"
            app:strokeColor="@color/primary_neon_orange"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/iv_small_profile_pic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="שלום, אלוף"
            android:textColor="@color/primary_neon_orange"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="@id/card_small_profile"
            app:layout_constraintBottom_toBottomOf="@id/card_small_profile"
            app:layout_constraintStart_toEndOf="@id/card_small_profile" />

        <ImageButton
            android:id="@+id/btn_logout"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_lock_power_off"
            app:tint="@color/primary_electric_red"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="READY FOR ACTION?"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/card_small_profile"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Last Session Section -->
        <TextView
            android:id="@+id/tv_label_last"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LATEST MISSION"
            android:textColor="@color/text_disabled"
            android:textSize="12sp"
            android:layout_marginTop="32dp"
            android:letterSpacing="0.2"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tv_label_last">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tv_dash_last_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00 KM"
                    android:textColor="@color/white"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_dash_last_pace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PACE: --:--"
                    android:textColor="@color/primary_neon_orange"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/tv_dash_last_distance"
                    app:layout_constraintStart_toStartOf="parent" />

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@android:drawable/ic_menu_directions"
                    app:tint="#33FF6D00"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Personal Records Section -->
        <TextView
            android:id="@+id/tv_label_records"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERSONAL RECORDS"
            android:textColor="@color/text_disabled"
            android:textSize="12sp"
            android:layout_marginTop="32dp"
            android:letterSpacing="0.2"
            app:layout_constraintTop_toBottomOf="@id/card_stats"
            app:layout_constraintStart_toStartOf="parent" />

        <GridLayout
            android:id="@+id/gl_records"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            app:layout_constraintTop_toBottomOf="@id/tv_label_records">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FASTEST 1K" android:textColor="@color/text_disabled" android:textSize="10sp"/>
                    <TextView android:id="@+id/tv_record_1k" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FASTEST 5K" android:textColor="@color/text_disabled" android:textSize="10sp"/>
                    <TextView android:id="@+id/tv_record_5k" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LONGEST" android:textColor="@color/text_disabled" android:textSize="10sp"/>
                    <TextView android:id="@+id/tv_record_longest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0 km" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MISSIONS" android:textColor="@color/text_disabled" android:textSize="10sp"/>
                    <TextView android:id="@+id/tv_record_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/primary_neon_orange" android:textSize="18sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>

        <!-- Quote -->
        <TextView
            android:id="@+id/tv_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="100dp"
            android:text="RESULTS DON'T CARE ABOUT YOUR EXCUSES."
            android:textColor="@color/text_disabled"
            android:textSize="12sp"
            android:gravity="center"
            android:textStyle="italic"
            app:layout_constraintTop_toBottomOf="@+id/gl_records" />

        <!-- Start Session Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_run"
            style="@style/Widget.App.Button.Pill"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="START NEW MISSION"
            android:textSize="20sp"
            android:backgroundTint="@color/primary_neon_orange"
            android:textColor="@color/black"
            app:elevation="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>